APP_PORT=8090
APP_ENV=production
APP_URL=http://localhost:8090
COOKIE_SECURE=false
DB_HOST=db
DB_PORT=3306
DB_HOST_PORT=3307
DB_NAME=cuj_datesheet
DB_USER=cuj_app
DB_PASSWORD=change_me_app_password
DB_ROOT_PASSWORD=change_me_root_password
ADMIN_NAME=Exam Cell Incharge
ADMIN_EMAIL=examcell@cuj.local
ADMIN_PASSWORD=ChangeMe#12345
SEED_DEMO_USERS=true
REF_SEQ_START=3000

# --- Outgoing email (admin "Reset password" mails the coordinator their new password) ---
# Leave SMTP_HOST empty to disable email; the temp password is then only shown to the admin.
# For local testing: `docker compose --profile tools up -d mailpit`, SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_SECURE=none, inbox at http://localhost:8026
SMTP_HOST=
SMTP_PORT=587
# none | starttls | ssl
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CUJ Exam Cell <no-reply@cuj.local>
