{
    "name": "cuj/datesheet-php",
    "description": "CUJ Exam Date Sheet Automation System (PHP stack)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-intl": "*",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
